    "Audio, captions and transcripts stay on this Mac. Deleting a meeting removes all of it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio, captions and transcripts stay on this Mac. Deleting a meeting removes all of it."

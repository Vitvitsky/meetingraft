        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук, субтитры и транскрипты остаются на этом Маке. Удаление встречи стирает всё разом."
          }
        }
      }
    },
    "Audio, live captions, transcripts and artifacts will be removed. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio, live captions, transcripts and artifacts will be removed. This cannot be undone."

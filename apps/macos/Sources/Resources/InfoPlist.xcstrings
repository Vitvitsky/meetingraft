  "strings": {
    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MeetingRaft records the system audio of the meeting (the other participants)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MeetingRaft записывает системный звук встречи (других участников)."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MeetingRaft records the microphone to caption your meeting."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MeetingRaft записывает микрофон для субтитров встречи."
          }
        }
      }
    }
  },
  "version": "1.0"
}

# Xcode / Swift
# Биндинги UniFFI генерируются apps/macos/Scripts/generate-ffi.sh из
# Rust-крейта ffi — как и сам .xcodeproj из project.yml. Держать их в
# истории значит ловить конфликт после каждого прогона verify-mac.sh.
apps/macos/Generated/*.swift
apps/macos/Generated/*.h
apps/macos/Generated/*.modulemap
build/
DerivedData/
apps/macos/.derived-data/
*.xcuserstate
*.xcuserdata/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.swiftpm/config/registries.json
.swiftpm/xcode/package.xcworkspace
.netrc
apps/macos/MeetingRaft.xcodeproj/
apps/macos/Sources/Info.plist

# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# UniFFI / generated bindings (track only intentionally committed outputs)
# uncomment if you regenerate bindings in CI and do not commit them:
# apps/macos/**/Generated/

